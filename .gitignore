# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Jupyter Notebook
.ipynb_checkpoints/

# Data (raw data not tracked)
data/raw/*
!data/raw/.gitkeep

# Processed data (regenerable)
data/processed/*
!data/processed/.gitkeep

# Models (too large for git)
models/*.pkl
models/*.pt
models/*.joblib
models/*.h5
models/*.onnx
!models/.gitkeep

# Outputs — keep example outputs so GitHub viewers can see results
!outputs/figures/.gitkeep
!outputs/forecasts/.gitkeep

# Environment variables
.env
.env.local
*.env

# Logs
*.log
logs/

# Test / Coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Parquet files in project root (should be in data/)
*.parquet
